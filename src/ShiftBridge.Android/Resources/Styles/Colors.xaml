<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Mêmes couleurs que le thème WPF (ShiftBridge.App/Themes/Theme.xaml) -->
    <Color x:Key="Bg">#111418</Color>
    <Color x:Key="Sidebar">#0B0D10</Color>
    <Color x:Key="Surface">#1A1F25</Color>
    <Color x:Key="SurfaceHover">#232A32</Color>
    <Color x:Key="Line">#2C343D</Color>
    <Color x:Key="Text">#E9EDF1</Color>
    <Color x:Key="TextMuted">#8B96A3</Color>
    <Color x:Key="Accent">#FF6A2B</Color>
    <Color x:Key="Success">#2BD46A</Color>
    <Color x:Key="Warning">#F5B041</Color>
    <Color x:Key="Danger">#FF6B6F</Color> <!-- 6:1 sur les cartes (lisible pour « Arrêter ») -->
    <Color x:Key="Off">#4A5460</Color>
</ResourceDictionary>
