<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="ShiftBridge.Mobile.Views.AppsView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:loc="clr-namespace:ShiftBridge.Core.Localization;assembly=ShiftBridge.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShiftBridge.Presentation;assembly=ShiftBridge.Presentation"
             xmlns:ctl="clr-namespace:ShiftBridge.Mobile"
             x:DataType="vm:MainViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16,16" Spacing="0">
            <Label Style="{StaticResource Caption}" Margin="0,0,0,14"
                   Text="{x:Static loc:Strings.Apps_Intro}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="{x:Static ctl:Icons.Link}" FontFamily="MaterialIcons" FontSize="22" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{x:Static loc:Strings.Apps_HowConnects}" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Bluetooth" FontAttributes="Bold" />
                            <Label Text="{Binding BleStatus}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding EnableBle}" VerticalOptions="Center" SemanticProperties.Description="Bluetooth" />
                    </Grid>
                    <Label Style="{StaticResource Caption}"
                           Text="{x:Static loc:Strings.Apps_BleNote}" />

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="{x:Static loc:Strings.Apps_WifiLan}" FontAttributes="Bold" />
                            <Label Text="{Binding NetworkStatus}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding EnableNetwork}" VerticalOptions="Center" SemanticProperties.Description="{x:Static loc:Strings.Apps_WifiLan}" />
                    </Grid>

                    <Label Text="{Binding LocalAddressText}" Style="{StaticResource Caption}"
                           IsVisible="{Binding LocalAddressText, Converter={StaticResource HasText}}" />

                    <Label Style="{StaticResource Caption}"
                           Text="{x:Static loc:Strings.Apps_AtLeastOne}" />
                </VerticalStackLayout>
            </Border>

            <!-- Avancé -->
            <ctl:CollapsibleSection Title="{x:Static loc:Strings.Common_AdvancedShort}">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="{x:Static loc:Strings.Apps_DirCon}" FontAttributes="Bold" />
                            <Label Text="{Binding DirConStatus}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding EnableDirCon}" VerticalOptions="Center" SemanticProperties.Description="DirCon" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                    <Label Text="{x:Static loc:Strings.Apps_TestTitle}" FontAttributes="Bold" />
                    <Label Style="{StaticResource Caption}"
                           Text="{x:Static loc:Strings.Apps_TestBody}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{x:Static loc:Strings.Btn_ShiftUp}" Command="{Binding TestShiftUpCommand}" />
                        <Button Text="{x:Static loc:Strings.Btn_ShiftDown}" Command="{Binding TestShiftDownCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            </ctl:CollapsibleSection>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
