<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="ShiftBridge.Mobile.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:loc="clr-namespace:ShiftBridge.Core.Localization;assembly=ShiftBridge.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShiftBridge.Presentation;assembly=ShiftBridge.Presentation"
             xmlns:sensors="clr-namespace:ShiftBridge.Platform.Sensors;assembly=ShiftBridge.Platform"
             xmlns:ctl="clr-namespace:ShiftBridge.Mobile"
             x:DataType="vm:MainViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16,16" Spacing="0">
            <Label Style="{StaticResource Caption}" Margin="0,0,0,14"
                   Text="{x:Static loc:Strings.Devices_IntroNoKeyboard}" />

            <!-- 1. Manettes Zwift -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
                <Label Text="{x:Static ctl:Icons.Controller}" FontFamily="MaterialIcons" FontSize="22" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{x:Static loc:Strings.Devices_SecControllers}" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="{x:Static loc:Strings.Devices_Scanning}" Style="{StaticResource Caption}" VerticalOptions="Center"
                       IsVisible="{Binding IsScanning}" />
            </Grid>
            <Button Text="{x:Static loc:Strings.Devices_Scan}" Command="{Binding StartScanCommand}" Style="{StaticResource PrimaryButton}"
                    HorizontalOptions="Start" Margin="0,0,0,12" />

            <!-- Aucune manette -->
            <Border Style="{StaticResource Card}" Padding="24"
                    IsVisible="{Binding Devices.Count, Converter={StaticResource EqualsToBool}, ConverterParameter=0}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static loc:Strings.Devices_NoneFound}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                           Text="{x:Static loc:Strings.Devices_NoneHint}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Devices}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceRowViewModel">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <ctl:StatusBadge Grid.Column="0" State="{Binding State}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" />
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding StateText}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding BatteryText}" Style="{StaticResource Caption}" IsVisible="{Binding HasBattery}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    <Button Text="{x:Static loc:Strings.Dev_Pair}" Clicked="OnPairClicked" Padding="12,0" IsVisible="{Binding CanPair}" />
                                    <Button Text="{Binding ActionText}" Clicked="OnToggleClicked" Padding="12,0" />
                                    <Button Text="⋮" Clicked="OnMoreClicked" Style="{StaticResource GhostButton}" Padding="8,0" MinimumWidthRequest="48" MinimumHeightRequest="48"
                                            SemanticProperties.Description="{x:Static loc:Strings.Devices_MoreActions}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <ctl:CollapsibleSection Title="{x:Static loc:Strings.Devices_NotFoundTitle}">
                <Label Style="{StaticResource Caption}" Text="{x:Static loc:Strings.Devices_NotFoundCombined}" />
            </ctl:CollapsibleSection>

            <!-- 2. Cardio : ceinture ou montre Bluetooth, republiée à l'appli par le proxy trainer -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,12">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Label Text="{x:Static ctl:Icons.Heart}" FontFamily="MaterialIcons" FontSize="22" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{x:Static loc:Strings.Hr_Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                        <ctl:InfoButton Grid.Column="2" HorizontalOptions="Start" Heading="{x:Static loc:Strings.Hr_Title}" Message="{x:Static loc:Strings.Hr_Tip}" />
                    </Grid>
                    <Label Style="{StaticResource Caption}" Text="{x:Static loc:Strings.Hr_Help}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{Binding HeartRateScanButtonText}" Command="{Binding ToggleHeartRateScanCommand}" />
                        <Button Text="{x:Static loc:Strings.Hr_Connect}" Command="{Binding ConnectHeartRateCommand}" />
                        <Button Text="{x:Static loc:Strings.Hr_Disconnect}" Command="{Binding DisconnectHeartRateCommand}" IsVisible="{Binding HeartRateConnected}" />
                    </HorizontalStackLayout>
                    <CollectionView ItemsSource="{Binding FoundHeartRateSensors}" SelectedItem="{Binding SelectedHeartRateSensor}"
                                    SelectionMode="Single" HeightRequest="110" EmptyView="{x:Static loc:Strings.List_HrEmpty}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="sensors:DiscoveredHeartRateSensor">
                                <VerticalStackLayout Padding="8,6">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding DetailText}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <HorizontalStackLayout Spacing="10">
                        <ctl:StatusBadge State="{Binding HeartRateState}" />
                        <Label Text="{Binding HeartRateStatus}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Avancé -->
            <ctl:CollapsibleSection Title="{x:Static loc:Strings.Common_AdvancedShort}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding AutoReconnect}" VerticalOptions="Center" SemanticProperties.Description="{x:Static loc:Strings.Devices_AutoReconnect}" />
                            <Label Text="{x:Static loc:Strings.Devices_AutoReconnect}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding ControllerVibration}" VerticalOptions="Center" SemanticProperties.Description="{x:Static loc:Strings.Devices_Vibration}" />
                            <Label Text="{x:Static loc:Strings.Devices_Vibration}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding SramAxsAdvanced}" VerticalOptions="Center" SemanticProperties.Description="{x:Static loc:Strings.Axs_AdvancedLabel}" />
                            <Label Text="{x:Static loc:Strings.Axs_AdvancedLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{x:Static loc:Strings.Axs_AdvancedHint}" Style="{StaticResource Caption}" />
                        <Label Text="{x:Static loc:Strings.Ltwoo_PinLabel}" />
                        <Entry Text="{Binding LtwooPin}" MaxLength="3" WidthRequest="90" HorizontalOptions="Start" SemanticProperties.Description="{x:Static loc:Strings.Ltwoo_PinLabel}" />
                        <Label Text="{x:Static loc:Strings.Ltwoo_PinHint}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
            </ctl:CollapsibleSection>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
