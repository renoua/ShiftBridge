<UserControl x:Class="ShiftBridge.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:ShiftBridge.Core.Localization;assembly=ShiftBridge.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="860">
            <TextBlock Text="{x:Static loc:Strings.Nav_Settings}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                       Text="{x:Static loc:Strings.Settings_Intro}" />

            <!-- Affichage : superposition de la vitesse virtuelle au-dessus du jeu -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionIcon}" Text="&#xE7F4;" />
                        <TextBlock Text="{x:Static loc:Strings.Settings_SecDisplay}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="{x:Static loc:Strings.Trainer_ShowOverlay}" IsChecked="{Binding ShowOverlay}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="50,4,0,0"
                               Text="{x:Static loc:Strings.Trainer_OverlayHelp}" />
                    <StackPanel Visibility="{Binding ShowOverlay, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="{x:Static loc:Strings.Trainer_Lock}" IsChecked="{Binding OverlayLocked}" Margin="0,12,0,0" />
                        <CheckBox Content="{x:Static loc:Strings.Trainer_GearBar}" IsChecked="{Binding OverlayShowBar}" Margin="0,10,0,0" />
                        <CheckBox Content="{x:Static loc:Strings.Trainer_Flash}" IsChecked="{Binding OverlayFlash}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="{x:Static loc:Strings.Trainer_Telemetry}" IsChecked="{Binding OverlayShowTelemetry}" />
                            <TextBlock Style="{StaticResource InfoIcon}" VerticalAlignment="Center"
                                       ToolTip="{x:Static loc:Strings.Trainer_TelemetryTip}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{x:Static loc:Strings.Trainer_Opacity}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Slider Minimum="0.2" Maximum="1" Value="{Binding OverlayOpacity}" Width="160" VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Static loc:Strings.Trainer_OpacityName}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Démarrage (Windows) : lancement avec Windows, zone de notification -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasLocalInput, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionIcon}" Text="&#xE7E8;" />
                        <TextBlock Text="{x:Static loc:Strings.Settings_SecStartup}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="{x:Static loc:Strings.App_StartWithWindows}" IsChecked="{Binding StartWithWindows}" />
                    <CheckBox Content="{x:Static loc:Strings.App_MinimizeToTray}" IsChecked="{Binding MinimizeToTray}" Margin="0,10,0,0" />
                    <CheckBox Content="{x:Static loc:Strings.App_StartMinimized}" IsChecked="{Binding StartMinimized}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Mises à jour (Windows) -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasUpdater, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionIcon}" Text="&#xE895;" />
                        <TextBlock Text="{x:Static loc:Strings.Settings_SecUpdates}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="{x:Static loc:Strings.Settings_CheckUpdates}" IsChecked="{Binding CheckForUpdates}" />
                    <CheckBox Content="{x:Static loc:Strings.Settings_IncludePrereleases}" IsChecked="{Binding IncludePrereleases}" Margin="0,6,0,0"
                              ToolTip="{x:Static loc:Strings.Settings_IncludePrereleasesHelp}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{x:Static loc:Strings.Settings_CheckNow}" Command="{Binding CheckUpdatesNowCommand}" />
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasPendingUpdate, Converter={StaticResource BoolToVis}}">
                        <Button Content="{x:Static loc:Strings.Update_Install}" Command="{Binding ApplyUpdateCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="16,6" />
                        <Button Content="{x:Static loc:Strings.Update_Notes}" Command="{Binding OpenReleaseNotesCommand}" Padding="12,6" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateProgressText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{x:Static loc:Strings.Settings_UpdatesHelp}" />
                </StackPanel>
            </Border>

            <!-- Langue : le changement s'applique au redémarrage -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionIcon}" Text="&#xE774;" />
                        <TextBlock Text="{x:Static loc:Strings.Settings_SecLanguage}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"
                              HorizontalAlignment="Left" Width="240"
                              AutomationProperties.Name="{x:Static loc:Strings.Lang_Label}" />
                    <TextBlock Text="{x:Static loc:Strings.Lang_RestartNote}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Visibility="{Binding LanguageRestartNeeded, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Outils : journal de diagnostic -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionIcon}" Text="&#xE90F;" />
                        <TextBlock Text="{x:Static loc:Strings.Settings_SecTools}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="{x:Static loc:Strings.Settings_OpenDiagnostic}" Command="{Binding NavigateCommand}" CommandParameter="diagnostic"
                            HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="{x:Static loc:Strings.Settings_ToolsHelp}" />
                    <Button Content="{x:Static loc:Strings.Settings_PrivacyPolicy}" Command="{Binding OpenPrivacyPolicyCommand}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="{x:Static loc:Strings.Settings_PrivacyHelp}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
