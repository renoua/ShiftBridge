<UserControl x:Class="ShiftBridge.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:ShiftBridge.Core.Localization;assembly=ShiftBridge.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ShiftBridge.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="860">
            <TextBlock Text="{x:Static loc:Strings.Nav_Controllers}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                       Text="{x:Static loc:Strings.Devices_Intro}" />

            <!-- 1. Manettes Zwift -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{x:Static loc:Strings.Devices_Scanning}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource SectionIcon}" Text="&#xE7FC;" />
                <TextBlock Text="{x:Static loc:Strings.Devices_SecControllers}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="{x:Static loc:Strings.Devices_Scan}" Command="{Binding StartScanCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>

            <!-- Aucune manette -->
            <Border Padding="28">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="34" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="{x:Static loc:Strings.Devices_NoneFound}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"
                               Text="{x:Static loc:Strings.Devices_NoneHint}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10" ToolTip="{Binding Detail}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:StatusBadge State="{Binding State}" Margin="0,0,16,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" />
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                                    Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE83F;" FontSize="13" Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Text="{Binding BatteryText}" Style="{StaticResource Caption}" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{x:Static loc:Strings.Dev_Pair}" Margin="0,0,8,0" Padding="14,6" Style="{StaticResource PrimaryButton}"
                                            Visibility="{Binding CanPair, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.PairDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{Binding ActionText}" Margin="0,0,8,0" Padding="14,6"
                                            Command="{Binding DataContext.ToggleDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="&#xE712;" Style="{StaticResource IconButton}"
                                            AutomationProperties.Name="{x:Static loc:Strings.Devices_MoreActions}"
                                            ToolTip="{x:Static loc:Strings.Devices_MoreActions}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Click="MoreButton_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{x:Static loc:Strings.Dev_Rename}"
                                                          Command="{Binding PlacementTarget.Tag.RenameDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="{x:Static loc:Strings.Devices_Vibrate}" IsEnabled="{Binding CanVibrate}"
                                                          Command="{Binding PlacementTarget.Tag.VibrateDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="{x:Static loc:Strings.Devices_Forget}" Style="{StaticResource DangerMenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.ForgetDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander Header="{x:Static loc:Strings.Devices_NotFoundTitle}" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Text="{x:Static loc:Strings.Devices_NotFoundBody}" />
            </Expander>

            <!-- 2. Cardio : ceinture ou montre Bluetooth, republiée à l'appli d'entraînement par le proxy trainer -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionIcon}" Text="&#xEB51;" />
                        <TextBlock Text="{x:Static loc:Strings.Hr_Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource InfoIcon}" ToolTip="{x:Static loc:Strings.Hr_Tip}" />
                    </StackPanel>
                    <TextBlock Text="{x:Static loc:Strings.Hr_Help}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{Binding HeartRateScanButtonText}" Command="{Binding ToggleHeartRateScanCommand}" Margin="0,0,8,0" />
                        <Button Content="{x:Static loc:Strings.Hr_Connect}" Command="{Binding ConnectHeartRateCommand}" Margin="0,0,8,0" />
                        <Button Content="{x:Static loc:Strings.Hr_Disconnect}" Command="{Binding DisconnectHeartRateCommand}"
                                Visibility="{Binding HeartRateConnected, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="HeartRateList" ItemsSource="{Binding FoundHeartRateSensors}" SelectedItem="{Binding SelectedHeartRateSensor}" MinHeight="40" MaxHeight="130" />
                        <TextBlock Text="{x:Static loc:Strings.List_HrEmpty}" Style="{StaticResource Caption}" Margin="10,8" IsHitTestVisible="False"
                                   Visibility="{Binding HasItems, ElementName=HeartRateList, Converter={StaticResource InvBoolToVis}}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <controls:StatusBadge State="{Binding HeartRateState}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding HeartRateStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Clavier, télécommandes HID et manettes de jeu (Windows) -->
            <StackPanel Visibility="{Binding HasLocalInput, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Style="{StaticResource SectionIcon}" Text="&#xE765;" />
                    <TextBlock Text="{x:Static loc:Strings.Devices_LocalTitle}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" TextWrapping="Wrap"
                           Text="{x:Static loc:Strings.Devices_LocalIntro}" />
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <CheckBox Content="{x:Static loc:Strings.Devices_UseKeyboard}" IsChecked="{Binding KeyboardInputEnabled}" />
                        <CheckBox Content="{x:Static loc:Strings.Devices_SuppressKeys}"
                                  IsChecked="{Binding SuppressBoundKeys}" Margin="24,8,0,0"
                                  IsEnabled="{Binding KeyboardInputEnabled}" />
                        <CheckBox Content="{x:Static loc:Strings.Devices_UseGamepads}" IsChecked="{Binding GamepadInputEnabled}" Margin="0,12,0,0" />
                        <ItemsControl ItemsSource="{Binding LocalDevices}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center"
                                                 Fill="{StaticResource Accent}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Avancé -->
            <Expander Header="{x:Static loc:Strings.Common_AdvancedShort}" Style="{StaticResource AdvancedExpander}" Margin="0,14,0,0">
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <CheckBox Content="{x:Static loc:Strings.Devices_AutoReconnect}" IsChecked="{Binding AutoReconnect}" />
                        <CheckBox Content="{x:Static loc:Strings.Devices_Vibration}" IsChecked="{Binding ControllerVibration}" Margin="0,8,0,0" />
                        <CheckBox Content="{x:Static loc:Strings.Axs_AdvancedLabel}" IsChecked="{Binding SramAxsAdvanced}" Margin="0,14,0,0" />
                        <TextBlock Text="{x:Static loc:Strings.Axs_AdvancedHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{x:Static loc:Strings.Ltwoo_PinLabel}" Margin="0,14,0,4" />
                        <TextBox Text="{Binding LtwooPin, UpdateSourceTrigger=LostFocus}" MaxLength="3" Width="90" HorizontalAlignment="Left" ToolTip="{x:Static loc:Strings.Ltwoo_PinHint}" />
                        <TextBlock Text="{x:Static loc:Strings.Ltwoo_PinHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
