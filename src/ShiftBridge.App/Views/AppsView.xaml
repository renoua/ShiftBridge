<UserControl x:Class="ShiftBridge.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:ShiftBridge.Core.Localization;assembly=ShiftBridge.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="860">
            <TextBlock Text="{x:Static loc:Strings.Nav_App}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                       Text="{x:Static loc:Strings.Apps_Intro}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource SectionIcon}" Text="&#xE71B;" />
                        <TextBlock Text="{x:Static loc:Strings.Apps_HowConnects}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bluetooth" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BleStatus}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableBle}" AutomationProperties.Name="Bluetooth" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Border}" Margin="0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.Apps_WifiLan}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding NetworkStatus}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableNetwork}" AutomationProperties.Name="{x:Static loc:Strings.Apps_WifiLan}" />
                    </Grid>
                    <!-- Adresse et port à saisir dans l'appli si elle ne trouve pas ShiftBridge toute seule (sélectionnable pour la copier) -->
                    <TextBox Text="{Binding LocalAddressText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Padding="0"
                             Visibility="{Binding LocalAddressText, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0"
                               Text="{x:Static loc:Strings.Apps_AtLeastOne}" />
                </StackPanel>
            </Border>

            <!-- Avancé : DirCon et test des vitesses -->
            <Expander Header="{x:Static loc:Strings.Common_AdvancedShort}" Style="{StaticResource AdvancedExpander}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Apps_DirCon}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DirConStatus}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding EnableDirCon}" AutomationProperties.Name="DirCon" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Border}" Margin="0,16" />

                        <TextBlock Text="{x:Static loc:Strings.Apps_TestTitle}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10"
                                   Text="{x:Static loc:Strings.Apps_TestBody}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static loc:Strings.Btn_ShiftUp}" Command="{Binding TestShiftUpCommand}" Margin="0,0,8,0" />
                            <Button Content="{x:Static loc:Strings.Btn_ShiftDown}" Command="{Binding TestShiftDownCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
