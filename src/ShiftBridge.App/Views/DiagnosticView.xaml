<UserControl x:Class="ShiftBridge.App.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:ShiftBridge.Core.Localization;assembly=ShiftBridge.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="36,30,36,30">
        <StackPanel DockPanel.Dock="Top">
            <!-- Flèche en glyphe (et non dans le texte traduit, que le lecteur d'écran lisait « flèche gauche Réglages ») -->
            <Button Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.Name="{x:Static loc:Strings.Settings_BackToSettings}"
                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-16,-8,0,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="{x:Static loc:Strings.Settings_BackToSettings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>
            <TextBlock Text="{x:Static loc:Strings.Nav_Diagnostic}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                       Text="{x:Static loc:Strings.Diag_Intro}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="{x:Static loc:Strings.Diag_Copy}" Command="{Binding CopyLogCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:Strings.Diag_Clear}" Command="{Binding ClearLogCommand}" Style="{StaticResource GhostButton}" Margin="0,0,20,0" />
                <CheckBox Content="{x:Static loc:Strings.Diag_Verbose}" IsChecked="{Binding VerboseFrames}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LogStatus}" Style="{StaticResource Caption}" Foreground="{StaticResource Success}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
            <!-- Inspecteur Bluetooth : pour capturer les trames d'une télécommande encore inconnue -->
            <TextBlock Text="{x:Static loc:Strings.Inspect_Title}" Style="{StaticResource SectionTitle}" Margin="0,4,0,2" />
            <TextBlock Text="{x:Static loc:Strings.Inspect_Intro}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{Binding InspectorScanText}" Command="{Binding ToggleInspectorScanCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:Strings.Inspect_StopCapture}" Command="{Binding StopInspectorCaptureCommand}" Style="{StaticResource GhostButton}"
                        Visibility="{Binding IsInspectorCapturing, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Strings.Inspect_Empty}" Style="{StaticResource Caption}"
                               Visibility="{Binding InspectorEmpty, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding InspectorDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.CaptureInspectedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Diag_AddNote}" Command="{Binding AddNoteCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static loc:Strings.Diag_NoteTip}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddNoteCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </StackPanel>
        <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 Background="{StaticResource Sidebar}" Foreground="{StaticResource TextMuted}" Padding="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </DockPanel>
</UserControl>
