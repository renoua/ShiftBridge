<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ShiftBridge.Core.Localization"
             xmlns:vm="using:ShiftBridge.Presentation"
             x:Class="ShiftBridge.Desktop.Views.TrainerView" x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Spacing="14" Margin="0,18,0,24">
      <TextBlock Classes="title" Text="{x:Static loc:Strings.Nav_Trainer}" />
      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="{Binding TrainerSummary}" />
            <TextBlock Classes="detail" Text="{Binding TrainerStatus}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="accent" Content="{Binding ProxyButtonText}" Command="{Binding ToggleProxyCommand}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="{x:Static loc:Strings.Trainer_ConnTitle}" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <RadioButton GroupName="trainer" Content="Bluetooth" IsChecked="{Binding UseBluetooth}" />
            <RadioButton GroupName="trainer" Content="Wi-Fi / DirCon" IsChecked="{Binding UseWifi}" />
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding UseBluetooth}">
            <Button Content="{Binding BleScanButtonText}" Command="{Binding ToggleBleScanCommand}" />
            <ComboBox ItemsSource="{Binding FoundBleTrainers}" SelectedItem="{Binding SelectedBleTrainer}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{x:Static loc:Strings.Nav_Trainer}" />
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding UseWifi}">
            <Button Content="{x:Static loc:Strings.Trainer_BtnFind}" Command="{Binding FindTrainersCommand}" />
            <ComboBox ItemsSource="{Binding FoundTrainers}" SelectedItem="{Binding SelectedTrainer}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{x:Static loc:Strings.Nav_Trainer}" />
            <TextBlock Classes="detail" Text="{x:Static loc:Strings.Trainer_ManualIpPort}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Width="220" Text="{Binding TrainerHost}" PlaceholderText="192.168.1.10" ToolTip.Tip="{x:Static loc:Strings.Trainer_IpTip}" />
              <TextBox Width="90" Text="{Binding TrainerPortText}" PlaceholderText="36866" />
            </StackPanel>
          </StackPanel>
          <CheckBox Content="{x:Static loc:Strings.Trainer_AutoStart}" IsChecked="{Binding AutoStartVirtualShifting}" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="{x:Static loc:Strings.Trainer_Gearing}" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="detail" Text="{x:Static loc:Strings.Trainer_Chainring}" />
              <TextBox Text="{Binding ChainringText}" Width="104" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="detail" Text="{x:Static loc:Strings.Trainer_Cog}" />
              <TextBox Text="{Binding CogText}" Width="104" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="detail" Text="{Binding DrivetrainInfo}" />
          <TextBlock Text="{Binding GearCountText}" />
          <Slider Value="{Binding GearCountValue}" Minimum="8" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                  AutomationProperties.Name="{x:Static loc:Strings.Trainer_GearCount}" />
        </StackPanel>
      </Border>
      <Expander Header="{x:Static loc:Strings.Common_AdvancedShort}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">
          <CheckBox Content="{x:Static loc:Strings.Trainer_Native}" IsChecked="{Binding NativeZwiftMode}" />
          <TextBlock Classes="detail" Text="{Binding NativeStatus}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Classes="detail" Text="{x:Static loc:Strings.Trainer_RiderWeight}" />
              <TextBox Text="{Binding RiderWeightText}" Width="110" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="detail" Text="{x:Static loc:Strings.Trainer_BikeWeight}" />
              <TextBox Text="{Binding BikeWeightText}" Width="110" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
          <CheckBox Content="{x:Static loc:Strings.Trainer_ReportGear}" IsChecked="{Binding ReportGearToApp}" />
          <CheckBox Content="{x:Static loc:Strings.Trainer_SlopeOnly}" IsChecked="{Binding SlopeOnlyMode}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Static loc:Strings.Trainer_Measure}" Command="{Binding MeasureDrivetrainCommand}" IsEnabled="{Binding CanMeasure}" />
            <Button Content="{x:Static loc:Strings.Trainer_UseMeasure}" Command="{Binding UseMeasuredRatioCommand}" IsEnabled="{Binding CanUseMeasurement}" />
          </StackPanel>
          <TextBlock Classes="detail" Text="{Binding MeasureResult}" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
