<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ShiftBridge.Core.Localization"
             xmlns:vm="using:ShiftBridge.Presentation"
             x:Class="ShiftBridge.Desktop.Views.ButtonsView" x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Spacing="14" Margin="0,18,0,24">
      <TextBlock Classes="title" Text="{x:Static loc:Strings.Nav_Buttons}" />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="detail" Text="{x:Static loc:Strings.Profile_Label}" />
              <ComboBox ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfileOption}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Static loc:Strings.Profile_Label}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="detail" Text="{x:Static loc:Strings.Buttons_RepeatSpeed}" />
              <ComboBox ItemsSource="{Binding RepeatSpeedOptions}" SelectedItem="{Binding SelectedRepeatSpeed}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Static loc:Strings.Buttons_RepeatSpeed}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding ActiveProfileText}" />
          <TextBlock Classes="detail" Text="{Binding ConnectedAppText}" />
          <WrapPanel>
            <Button Margin="0,0,8,0" Content="{Binding CreateAppProfileText}" Command="{Binding CreateAppProfileCommand}" IsVisible="{Binding CanCreateAppProfile}" />
            <Button Margin="0,0,8,0" Content="{x:Static loc:Strings.Profile_Delete}" Command="{Binding DeleteProfileCommand}" IsVisible="{Binding CanDeleteProfile}" />
            <Button Content="{x:Static loc:Strings.Buttons_Reset}" Command="{Binding ResetProfileCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding ButtonGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ButtonGroupViewModel">
            <Border Classes="card" Margin="0,0,0,10">
              <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="{Binding Name}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ButtonRowViewModel">
                      <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="10" Margin="0,3" ToolTip.Tip="{Binding Tooltip}">
                        <Grid ColumnDefinitions="14,*" VerticalAlignment="Center">
                          <Ellipse Fill="#87E1CB" Width="7" Height="7" IsVisible="{Binding IsPressed}" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" />
                        </Grid>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Actions}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{Binding Label}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActionItem">
                              <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                          <CheckBox Content="{x:Static loc:Strings.Buttons_Repeat}" IsVisible="{Binding CanRepeat}" IsChecked="{Binding RepeatOnHold}" />
                          <TextBox Width="56" IsVisible="{Binding CanTarget}" Text="{Binding GearTargetText}" ToolTip.Tip="{x:Static loc:Strings.Buttons_GearTargetTip}" />
                          <TextBox Width="56" IsVisible="{Binding CanStep}" Text="{Binding GearStepsText}" ToolTip.Tip="{x:Static loc:Strings.Buttons_GearStepsTip}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
