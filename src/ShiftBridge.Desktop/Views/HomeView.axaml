<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ShiftBridge.Core.Localization"
             xmlns:vm="using:ShiftBridge.Presentation"
             x:Class="ShiftBridge.Desktop.Views.HomeView" x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Spacing="14" Margin="0,18,0,24">
      <Border Classes="card" IsVisible="{Binding UpdateAvailable}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Classes="section" Text="{Binding UpdateText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{x:Static loc:Strings.Update_Later}" Command="{Binding DismissUpdateCommand}" />
        </Grid>
      </Border>
      <Border Classes="card" Background="#17302E" BorderBrush="#34534F" Padding="24">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecGear}" />
            <TextBlock FontSize="58" LineHeight="68" FontWeight="Bold" Foreground="#A7EFDB" Text="{Binding GearText}" />
            <TextBlock Classes="detail" Text="{Binding GearRatioText}" />
            <TextBlock Classes="detail" Text="{Binding ShiftModeText}" />
            <TextBlock FontSize="17" Text="{Binding LiveTelemetry}" Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="{x:Static loc:Strings.Btn_ShiftDown}" Command="{Binding ShiftDownCommand}" />
            <Button Classes="accent" Content="{x:Static loc:Strings.Btn_ShiftUp}" Command="{Binding ShiftUpCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecControllers}" />
            <TextBlock Classes="section" Text="{Binding ControllersSummary}" />
            <TextBlock Classes="detail" Text="{Binding ControllersDetail}" />
            <Button Content="{x:Static loc:Strings.Nav_Controllers}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Pages.Devices}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecTrainer}" />
            <TextBlock Classes="section" Text="{Binding TrainerSummary}" />
            <TextBlock Classes="detail" Text="{Binding TrainerDetail}" />
            <Button Content="{Binding ProxyButtonText}" Command="{Binding ToggleProxyCommand}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecHeartRate}" />
            <TextBlock Classes="section" Text="{Binding HeartRateSummary}" />
            <TextBlock Classes="detail" Text="{Binding HeartRateDetail}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecApp}" />
            <TextBlock Classes="section" Text="{Binding AppSummary}" />
            <TextBlock Classes="detail" Text="{Binding AppDetail}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
