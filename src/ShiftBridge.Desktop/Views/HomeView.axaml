<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ShiftBridge.Core.Localization"
             xmlns:vm="using:ShiftBridge.Presentation"
             x:Class="ShiftBridge.Desktop.Views.HomeView" x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Spacing="14" Margin="0,18,0,24">
      <!-- Mise à jour disponible : notes, installation (là où l'hôte sait se mettre à jour) ou téléchargement, plus tard -->
      <Border Classes="card" IsVisible="{Binding UpdateAvailable}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="section" Text="{Binding UpdateText}" />
            <TextBlock Classes="detail" Text="{Binding UpdateProgressText}" IsVisible="{Binding UpdateProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <Button Margin="0,0,8,0" Content="{x:Static loc:Strings.Update_Notes}" Command="{Binding OpenReleaseNotesCommand}" />
            <Button Margin="0,0,8,0" Classes="accent" Content="{x:Static loc:Strings.Update_Install}" Command="{Binding ApplyUpdateCommand}" IsVisible="{Binding HasUpdater}" />
            <Button Margin="0,0,8,0" Classes="accent" Content="{x:Static loc:Strings.Mac_ReleaseDownloads}" Command="{Binding OpenReleaseDownloadsCommand}" IsVisible="{Binding !HasUpdater}" />
            <Button Content="{x:Static loc:Strings.Update_Later}" Command="{Binding DismissUpdateCommand}" />
          </WrapPanel>
        </Grid>
      </Border>

      <!-- Prochaine étape (masquée quand tout est en place, ou à la demande) -->
      <Border Classes="card" BorderBrush="#87E1CB" IsVisible="{Binding HasNextStep}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding NextStepText}" VerticalAlignment="Center" />
          <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <Button Margin="0,0,8,0" Content="{x:Static loc:Strings.Home_HideNextStep}" Command="{Binding HideNextStepCommand}" />
            <Button Margin="0,0,8,0" Content="{x:Static loc:Strings.Home_OpenOnboarding}" Command="{Binding OpenOnboardingCommand}" />
            <Button Classes="accent" Content="{x:Static loc:Strings.Home_Open}" Command="{Binding NavigateCommand}" CommandParameter="{Binding NextStepPage}" />
          </WrapPanel>
        </Grid>
      </Border>

      <Border Classes="card" Background="#17302E" BorderBrush="#34534F" Padding="24">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="5">
            <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecGear}" />
            <TextBlock FontSize="58" LineHeight="68" FontWeight="Bold" Foreground="#A7EFDB" Text="{Binding GearText}" Classes.dim="{Binding !IsGearApplied}" />
            <TextBlock Classes="detail" Text="{Binding GearRatioText}" />
            <TextBlock Classes="detail" Text="{Binding ShiftModeText}" />
            <TextBlock FontSize="17" Text="{Binding LiveTelemetry}" Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{x:Static loc:Strings.Btn_ShiftDown}" Command="{Binding ShiftDownCommand}" />
              <Button Classes="accent" Content="{x:Static loc:Strings.Btn_ShiftUp}" Command="{Binding ShiftUpCommand}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Content="{Binding ProxyButtonText}" Command="{Binding ToggleProxyCommand}" />
            <TextBlock Classes="detail" Text="{Binding TrainerStatus}" TextAlignment="Right" MaxWidth="260" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Tuiles : même ordre que le parcours (manettes, touches, trainer, cardio, appli) ; « Ouvrir » mène à la page -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="badge" Fill="{Binding ControllersState, Converter={StaticResource StateBrush}}" />
              <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecControllers}" />
            </StackPanel>
            <TextBlock Classes="section" Text="{Binding ControllersSummary}" />
            <TextBlock Classes="detail" Text="{Binding ControllersDetail}" />
            <Button Content="{x:Static loc:Strings.Home_Open}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Pages.Devices}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="badge" Fill="{Binding ButtonsState, Converter={StaticResource StateBrush}}" />
              <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecButtons}" />
            </StackPanel>
            <TextBlock Classes="section" Text="{Binding ButtonsSummary}" />
            <TextBlock Classes="detail" Text="{Binding ButtonsDetail}" />
            <Button Content="{x:Static loc:Strings.Home_Open}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Pages.Buttons}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Classes="card">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="badge" Fill="{Binding TrainerState, Converter={StaticResource StateBrush}}" />
              <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecTrainer}" />
            </StackPanel>
            <TextBlock Classes="section" Text="{Binding TrainerSummary}" />
            <TextBlock Classes="detail" Text="{Binding TrainerDetail}" />
            <Button Content="{x:Static loc:Strings.Home_Open}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Pages.Trainer}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Classes="card">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="badge" Fill="{Binding HeartRateState, Converter={StaticResource StateBrush}}" />
              <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecHeartRate}" />
            </StackPanel>
            <TextBlock Classes="section" Text="{Binding HeartRateSummary}" />
            <TextBlock Classes="detail" Text="{Binding HeartRateDetail}" />
            <Button Content="{x:Static loc:Strings.Home_Open}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Pages.Devices}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="card">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="badge" Fill="{Binding AppState, Converter={StaticResource StateBrush}}" />
              <TextBlock Classes="label" Text="{x:Static loc:Strings.Home_SecApp}" />
            </StackPanel>
            <TextBlock Classes="section" Text="{Binding AppSummary}" />
            <TextBlock Classes="detail" Text="{Binding AppDetail}" />
            <Button Content="{x:Static loc:Strings.Home_Open}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Pages.Apps}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
