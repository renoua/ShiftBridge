<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ShiftBridge.Core.Localization"
             xmlns:vm="using:ShiftBridge.Presentation"
             x:Class="ShiftBridge.Desktop.Views.AppsView" x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Spacing="14" Margin="0,18,0,24">
      <TextBlock Classes="title" Text="{x:Static loc:Strings.Nav_App}" />
      <TextBlock Classes="detail" Text="{x:Static loc:Strings.Apps_Intro}" />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="{x:Static loc:Strings.Apps_HowConnects}" />
          <CheckBox Content="{x:Static loc:Strings.Net_ObcNetwork}" IsChecked="{Binding EnableNetwork}" />
          <TextBlock Classes="detail" Margin="30,0,0,0" Text="{Binding NetworkStatus}" />
          <CheckBox Content="{x:Static loc:Strings.Apps_DirCon}" IsChecked="{Binding EnableDirCon}" />
          <TextBlock Classes="detail" Margin="30,0,0,0" Text="{Binding DirConStatus}" />
          <SelectableTextBlock Margin="0,6,0,0" Text="{Binding LocalAddressText}" TextWrapping="Wrap" />
          <Button Content="{x:Static loc:Strings.Mac_LocalNetworkSettings}" Command="{Binding OpenLocalNetworkSettingsCommand}" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="{x:Static loc:Strings.Apps_TestTitle}" />
          <TextBlock Classes="detail" Text="{x:Static loc:Strings.Apps_TestBody}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Static loc:Strings.Btn_ShiftDown}" Command="{Binding TestShiftDownCommand}" />
            <Button Content="{x:Static loc:Strings.Btn_ShiftUp}" Command="{Binding TestShiftUpCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
